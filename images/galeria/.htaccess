# Galería pública: imágenes servidas, sin listado de directorios.
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
