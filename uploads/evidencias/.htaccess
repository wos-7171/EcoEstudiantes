# Evidencias subidas por estudiantes.
# Sin listado de directorios y sin ejecución de scripts.
# No se usan Options ni php_flag para evitar errores 500 en hosting compartido.
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh|exe|html?|js|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
